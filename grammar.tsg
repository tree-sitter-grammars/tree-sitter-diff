// diff grammar for tree-sitter (native DSL).
// Translated from grammar.js.

let NEWLINE: rule_t = regexp(r"\r?\n")
let WHITE_SPACE: rule_t = regexp(r"[\t\f\v ]+")
let ANYTHING: rule_t = regexp(r"[^\r\n]+")
let BASE85_LINE: str_t = r"[A-Za-z][0-9A-Za-z!#$%&()*+\-;<=>?@^_`{|}~]+"
let BASE85: str_t = concat(BASE85_LINE, "(?:", r"\r?\n", BASE85_LINE, ")*")

// Most JS `iseq(start, x)` calls are the 2-arg form; longer ones inline
// `token_immediate` directly.
macro iseq(start: str_t, rest: rule_t) rule_t {
    seq(token_immediate(start), rest)
}

grammar {
    language: "diff",
    extras: [WHITE_SPACE],
}

rule source {
    seq(
        repeat(choice(block, seq(optional(_line), NEWLINE))),
        optional(_line),
    )
}

rule _line {
    choice(
        file_change, binary_change, index, similarity, dissimilarity,
        old_file, new_file, location,
        addition, deletion, change, context, comment, special, unrecognized,
    )
}

rule block {
    prec_right(0, seq(
        command,
        NEWLINE,
        repeat(seq(
            choice(file_change, binary_change, index, similarity, dissimilarity),
            NEWLINE,
        )),
        optional(choice(
            seq(old_file, NEWLINE, new_file, NEWLINE, hunks),
            binary_patch,
        )),
    ))
}

rule binary_patch {
    prec_right(0, seq(
        seq(token_immediate("GIT"), "binary", "patch"),
        NEWLINE,
        field(forward, binary_hunk),
        optional(field(reverse, binary_hunk)),
    ))
}

rule binary_hunk {
    prec_right(0, seq(
        choice(token_immediate("literal"), token_immediate("delta")),
        alias(regexp(r"\d+"), size),
        NEWLINE,
        payload,
        NEWLINE,
        prec_right(0, repeat(NEWLINE)),
    ))
}

rule payload { token_immediate(regexp(BASE85)) }

rule hunks { prec_right(0, repeat1(hunk)) }

rule hunk {
    prec_right(0, seq(
        field(location, location),
        NEWLINE,
        optional(field(changes, changes)),
    ))
}

rule changes {
    prec_right(0, repeat1(seq(
        choice(
            alias(_hunk_addition, addition),
            alias(_hunk_deletion, deletion),
            addition,
            deletion,
            change,
            context,
            special,
            unrecognized,
        ),
        prec_right(0, repeat1(NEWLINE)),
    )))
}

rule command {
    seq(token_immediate("diff"), alias(regexp(r"[-\w]+"), argument), filename)
}

rule file_change {
    choice(
        seq(choice("new", "deleted"), "file", "mode", mode),
        seq(choice("new", "old"), "mode", mode),
        seq(choice("rename", "copy"), choice("from", "to"), filename),
    )
}

rule binary_change {
    seq(token_immediate("Binary"), "files", filename, "and", filename, "differ")
}

rule index {
    seq(token_immediate("index"), commit, "..", commit, optional(mode))
}

rule similarity {
    seq(token_immediate("similarity"), "index", alias(regexp(r"\d+"), score), "%")
}

rule dissimilarity {
    seq(token_immediate("dissimilarity"), "index", alias(regexp(r"\d+"), score), "%")
}

rule old_file { iseq("---", filename) }
rule new_file { iseq("+++", filename) }

rule location {
    seq(token_immediate("@@"), linerange, linerange, "@@", optional(ANYTHING))
}

rule _hunk_addition { iseq("+++", ANYTHING) }
rule _hunk_deletion { iseq("---", ANYTHING) }

rule addition {
    choice(
        iseq("+", optional(ANYTHING)),
        iseq("++", optional(ANYTHING)),
        token_immediate("+++"),
        iseq("++++", optional(ANYTHING)),
        iseq(">", optional(ANYTHING)),
    )
}

rule deletion {
    choice(
        iseq("-", optional(ANYTHING)),
        iseq("--", optional(ANYTHING)),
        token_immediate("---"),
        iseq("----", optional(ANYTHING)),
        iseq("<", optional(ANYTHING)),
    )
}

rule change { iseq("!", optional(ANYTHING)) }
rule context { iseq(" ", optional(ANYTHING)) }
rule comment { iseq("#", optional(ANYTHING)) }
rule special { iseq(r"\", optional(ANYTHING)) }
rule unrecognized { token(prec(-1, ANYTHING)) }

rule linerange { regexp(r"[-\+]\d+(,\d+)?") }
rule filename { repeat1(regexp(r"\S+")) }
rule commit { regexp(r"[a-f0-9]{4,64}") }
rule mode { regexp(r"\d+") }
